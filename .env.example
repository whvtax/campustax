# ─── CampusTax — Environment Variables ───────────────────────────────────
# Copy to .env.local for development. Set the same values in Vercel for
# production. NEVER commit .env.local to git.

# ─── Supabase (shared project with the WHV brand) ────────────────────────
# Same NEXT_PUBLIC_SUPABASE_URL as the WHV site (same project).
# SUPABASE_SERVICE_ROLE_KEY is server side only and never reaches the client.
# Run supabase/migrations/013_add_source_column.sql on the shared project
# BEFORE the first deployment, otherwise inserts will fail.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://campustax.com.au

# ─── Analytics (create NEW properties, do not reuse WHV ones) ────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
